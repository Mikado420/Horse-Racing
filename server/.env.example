# PostgreSQL 接続先
DATABASE_URL=postgres://postgres:postgres@localhost:5432/horses
# JWT 署名用の秘密鍵（本番では必ず長いランダム文字列に変更）
JWT_SECRET=change-me-to-a-long-random-string
PORT=2567
# 出走登録の締切までの秒数（最初の登録から数える）
REGISTRATION_SECONDS=30
# レース再生速度（2 = 実時間の2倍速）
REPLAY_SPEED=2
# 別のドメインに置いたクライアント（例: GitHub Pages）から接続を許可するオリジン。カンマ区切り。同じホストで配信するなら空でよい
CORS_ORIGINS=
