{
  "name": "@owners/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@colyseus/ws-transport": "^0.16.3",
    "@owners/shared": "0.1.0",
    "colyseus": "^0.16.4",
    "pg": "^8.13.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  }
}
